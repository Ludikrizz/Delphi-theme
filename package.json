{
	"name": "delphi-color-theme",
	"displayName": "Delφ Color Theme",
	"description": "Indigo blue dark and light themes for VS Code, from the delφ brand palette.",
	"version": "0.1.0",
	"publisher": "ludikrizz1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ludikrizz/Delphi-theme.git"
	},
	"homepage": "https://github.com/Ludikrizz/Delphi-theme#readme",
	"bugs": {
		"url": "https://github.com/Ludikrizz/Delphi-theme/issues"
	},
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Themes"
	],
	"keywords": [
		"theme",
		"color-theme",
		"dark",
		"light",
		"blue",
		"indigo",
		"navy"
	],
	"galleryBanner": {
		"color": "#062a55",
		"theme": "dark"
	},
	"contributes": {
		"themes": [
			{
				"label": "Delφ Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/delphi-dark.json"
			},
			{
				"label": "Delφ Light",
				"uiTheme": "vs",
				"path": "./themes/delphi-light.json"
			}
		]
	},
	"scripts": {
		"build": "node build.mjs",
		"package": "node build.mjs && npx --yes @vscode/vsce package"
	}
}
